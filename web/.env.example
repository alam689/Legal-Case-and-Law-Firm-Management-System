# docs/05-frontend-plan.md §15 — কোনো secret এই file-এ নয়, শুধু non-secret config।
# ব্যবহার: cp .env.example .env.local

# API base URL। MSW চালু থাকলে অগ্রাহ্য হয়।
VITE_API_BASE_URL=/api/v1

# dev server proxy target (vite.config.ts)
VITE_API_PROXY_TARGET=http://localhost:8000

# Backend তৈরি না হওয়া পর্যন্ত mock দিয়ে কাজ চলবে (docs/05 §11)
# enabled | disabled
VITE_API_MOCKING=enabled

# Sentry — PII scrubber ছাড়া কখনো চালু করা হবে না (docs/05 §15)
VITE_SENTRY_DSN=
VITE_APP_ENV=local
